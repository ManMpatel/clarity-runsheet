# Production env template — copy to backend/.env.production on the VPS and fill in.
#
#   cp backend/.env.production.example backend/.env.production
#
# Differs from .env.example in three ways: hostnames are Docker service DNS names (not localhost),
# origins are the real deployed frontends, and secrets have no dev defaults.
#
# NOTE: DATABASE_URL, REDIS_URL, TCP_INTERNAL_URL and NODE_ENV are set directly in
# docker-compose.prod.yml's `environment:` block and take precedence over anything set here —
# they're listed below only so the full runtime config is visible in one place.

# --- Postgres / TimescaleDB ---
# `postgres` is the compose service name, resolved on the internal network. The port is NOT
# published publicly (docker-compose.prod.yml binds it to 127.0.0.1 only).
# These three also need to exist in the SHELL env (or a root-level .env) when you run
# `docker compose up`, because the compose file interpolates them into the postgres service.
POSTGRES_USER=clarity
POSTGRES_PASSWORD=
POSTGRES_DB=clarity_fleet
DATABASE_URL=postgres://clarity:REPLACE_ME@postgres:5432/clarity_fleet

# --- Redis ---
# Only used for the tcp-listener -> ingestion telemetry_queue handoff (LPUSH/BRPOP).
REDIS_URL=redis://redis:6379

# --- Ports ---
TCP_PORT=5027
PORT=3000
SOCKET_PORT=3001

# --- tcp-listener internal command relay ---
# Must be the compose service DNS name, not localhost — api and tcp-listener are separate
# containers. This is what routes/vehicles.ts fetches for relay cut/restore and the metrics
# passthrough.
TCP_INTERNAL_PORT=4001
TCP_INTERNAL_URL=http://tcp-listener:4001

# --- Auth ---
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.clarity-software.com.au/auth/google/callback

# --- Frontend origins ---
# NODE_ENV=production means the localhost CORS escape hatch in api.ts / socket/index.ts is OFF.
# Every origin that must reach the API or socket has to be listed explicitly here.
WEB_URL=https://track.clarity-software.com.au
DASHBOARD_URL=https://track.clarity-software.com.au
# Comma-separated. Add Vercel preview deploys here if you need them to hit production.
CORS_ORIGINS=

# --- Stripe (live keys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price-ID -> tier mapping read by the billing webhook. Absent from .env.example; the webhook
# cannot resolve slot counts without these.
STRIPE_PRICE_ID_ENTRY=
STRIPE_PRICE_ID_MID=
STRIPE_PRICE_ID_TOP=

# --- Email (Resend) ---
RESEND_API_KEY=
ADMIN_EMAIL=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Push (Expo push service, proxies to FCM/APNs) ---
EXPO_ACCESS_TOKEN=

# --- Geocoding (reverse-geocode for vehicle_state.address) ---
MAPBOX_TOKEN=

# --- Mobile min-supported-version gate ---
MIN_SUPPORTED_MOBILE_VERSION=1.0.0
