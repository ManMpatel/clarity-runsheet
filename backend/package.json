{
  "name": "backend",
  "version": "1.0.0",
  "description": "Clarity Fleet backend — one codebase, three deployable entrypoints (api, tcp-listener, ingestion).",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start:api": "tsx src/entrypoints/api.ts",
    "start:tcp-listener": "tsx src/entrypoints/tcp-listener.ts",
    "start:ingestion": "tsx src/entrypoints/ingestion.ts",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:tcp-listener": "tsx watch src/entrypoints/tcp-listener.ts",
    "dev:ingestion": "tsx watch src/entrypoints/ingestion.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-demo-user": "tsx scripts/create-demo-user.ts",
    "seed-demo-fleet": "tsx scripts/seed-demo-fleet.ts"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.0",
    "expo-server-sdk": "^3.13.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^9.14.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^17.4.0",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
