# --- Postgres / TimescaleDB / PostGIS ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clarity_fleet

# --- Redis ---
# Used ONLY for the tcp-listener -> ingestion telemetry_queue handoff (LPUSH/BRPOP).
# Not used for sessions, caching, or job queues anywhere else in the backend.
REDIS_URL=redis://localhost:6379

# --- Ports ---
TCP_PORT=5027
PORT=3000
SOCKET_PORT=3001

# --- tcp-listener internal command relay (replaces the old Redis device:commands pub/sub) ---
TCP_INTERNAL_PORT=4001
# In Docker/prod this must resolve across containers (service DNS name), not localhost.
TCP_INTERNAL_URL=http://localhost:4001

# --- Auth ---
JWT_SECRET=change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Frontend origins ---
WEB_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price-ID -> tier mapping for the billing webhook slot-count fix (Phase 6). Fill in with
# your actual Stripe Price IDs — these can't be inferred from the codebase.
STRIPE_PRICE_ID_ENTRY=
STRIPE_PRICE_ID_MID=
STRIPE_PRICE_ID_TOP=

# --- Email (Resend) ---
RESEND_API_KEY=
ADMIN_EMAIL=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Push (Expo push service, proxies to FCM/APNs) ---
EXPO_ACCESS_TOKEN=

# --- Geocoding ---
MAPBOX_TOKEN=

# --- Mobile min-supported-version gate (Phase 4 platform middleware) ---
MIN_SUPPORTED_MOBILE_VERSION=1.0.0
