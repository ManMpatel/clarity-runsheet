# Base URL of the backend API (no trailing slash, no /api/v1 suffix).
# Phones/emulators can't reach "localhost" meaning their own device, so for local dev
# point this at your machine's LAN IP, e.g. http://192.168.1.23:3000
# (find it with `ipconfig` on Windows / `ifconfig` or `ip addr` on macOS/Linux).
#
# PRODUCTION MUST BE https:// — iOS App Transport Security blocks cleartext HTTP outright.
# Production builds should NOT rely on this file at all; see the `env` blocks in eas.json.
EXPO_PUBLIC_API_URL=

# Socket.IO server. This is a SEPARATE process and port from the API — it's the `ingestion`
# entrypoint listening on SOCKET_PORT (default 3001), not the api entrypoint on 3000.
# For local dev use the same LAN IP as above with port 3001.
#
# PRODUCTION MUST BE wss:// (or https://, which socket.io upgrades). Without this set, the app
# silently falls back to localhost and realtime never connects — no live map, no live alerts.
EXPO_PUBLIC_SOCKET_URL=

# Web-type OAuth client ID from Google Cloud/Firebase (same value as the backend's
# GOOGLE_CLIENT_ID) — required by GoogleSignin.configure() to mint an ID token the
# backend can verify. Must be the "Web application" client, not an Android client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps SDK for Android API key. Read by app.config.js — Android map tiles render blank
# grey without it. iOS uses Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Public URLs for the in-app legal links (required by the App Store).
EXPO_PUBLIC_PRIVACY_URL=https://clarity-software.com.au/privacy
EXPO_PUBLIC_TERMS_URL=https://clarity-software.com.au/terms
